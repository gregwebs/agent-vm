{
  "name": "agent-vm-normalized",
  "image": {
    "Oci": {
      "reference": "localhost:1/does-not-exist:latest",
      "root_disk": {
        "kind": "managed",
        "size_mib": 16384
      }
    }
  },
  "resources": {
    "cpus": 2,
    "memory_mib": 2048,
    "max_cpus": 2,
    "max_memory_mib": 2048
  },
  "runtime": {
    "workdir": "$PROJECT",
    "shell": "/bin/sh",
    "scripts": {},
    "entrypoint": null,
    "cmd": null,
    "hostname": null,
    "user": "$GUEST_UID:$GUEST_GID",
    "log_level": null,
    "metrics_sample_interval_ms": 1000,
    "disable_metrics_sample": false
  },
  "env": [
    {
      "key": "PATH",
      "value": "/usr/local/bin:/usr/bin:/usr/sbin:/bin"
    },
    {
      "key": "HOME",
      "value": "$HOME"
    },
    {
      "key": "USER",
      "value": "$GUEST_USER"
    },
    {
      "key": "LOGNAME",
      "value": "$GUEST_USER"
    },
    {
      "key": "IS_SANDBOX",
      "value": "1"
    },
    {
      "key": "LANG",
      "value": "C.UTF-8"
    },
    {
      "key": "COPILOT_GITHUB_TOKEN",
      "value": "msb-copilot-placeholder-v2"
    }
  ],
  "labels": {},
  "rlimits": [],
  "mounts": [
    {
      "type": "Bind",
      "host": "$PROJECT",
      "guest": "$PROJECT",
      "options": {
        "readonly": false,
        "noexec": false,
        "nosuid": false,
        "nodev": false
      },
      "stat_virtualization": "strict",
      "host_permissions": "private",
      "follow_root_symlinks": false,
      "quota_mib": null
    },
    {
      "type": "Bind",
      "host": "$STATE_DIR",
      "guest": "/agent-vm-state",
      "options": {
        "readonly": false,
        "noexec": false,
        "nosuid": false,
        "nodev": false
      },
      "stat_virtualization": "strict",
      "host_permissions": "private",
      "follow_root_symlinks": false,
      "quota_mib": null
    },
    {
      "type": "Bind",
      "host": "$STATE_DIR/home",
      "guest": "$HOME",
      "options": {
        "readonly": false,
        "noexec": false,
        "nosuid": false,
        "nodev": false
      },
      "stat_virtualization": "strict",
      "host_permissions": "private",
      "follow_root_symlinks": false,
      "quota_mib": null
    }
  ],
  "patches": [
    {
      "Append": {
        "path": "/etc/passwd",
        "content": "$GUEST_USER:x:$GUEST_UID:$GUEST_GID::$HOME:/bin/bash\n"
      }
    }
  ],
  "network": {
    "enabled": true,
    "interface": {},
    "ports": [],
    "policy": {
      "default_egress": "deny",
      "default_ingress": "allow",
      "rules": [
        {
          "direction": "egress",
          "destination": {
            "group": "host"
          },
          "protocols": [
            "udp",
            "tcp"
          ],
          "ports": [
            {
              "start": 53,
              "end": 53
            }
          ],
          "action": "allow"
        },
        {
          "direction": "egress",
          "destination": {
            "group": "public"
          },
          "protocols": [],
          "ports": [],
          "action": "allow"
        }
      ]
    },
    "dns": {
      "rebind_protection": true,
      "nameservers": [],
      "query_timeout_ms": 5000
    },
    "tls": {
      "enabled": true,
      "intercepted_ports": [
        443
      ],
      "bypass": [],
      "verify_upstream": true,
      "block_quic_on_intercept": true,
      "upstream_ca_cert": [],
      "scoped_upstream_ca_cert": [],
      "scoped_verify_upstream": [],
      "intercept_ca": {
        "cert_path": null,
        "key_path": null
      },
      "cache": {
        "capacity": 1000,
        "validity_hours": 24
      }
    },
    "intercept": {
      "rules": [],
      "hook": null,
      "max_request_bytes": 65536
    },
    "secrets": {
      "secrets": [
        {
          "env_var": "MSB_AGENT_VM_COPILOT_UNUSED",
          "value": "",
          "source": {
            "kind": "file",
            "path": "$STATE_DIR.secrets/copilot"
          },
          "placeholder": "msb-copilot-placeholder-v2",
          "allowed_hosts": [
            {
              "exact": "api.githubcopilot.com"
            },
            {
              "exact": "api.individual.githubcopilot.com"
            }
          ],
          "injection": {
            "headers": true,
            "basic_auth": false,
            "query_params": false,
            "body": false
          },
          "require_tls_identity": true
        }
      ],
      "on_violation": "block-and-log"
    },
    "max_connections": null,
    "trust_host_cas": false
  },
  "init": null,
  "pull_policy": "IfMissing",
  "security_profile": "default",
  "deployment_profile": "single_tenant",
  "lifecycle": {
    "ephemeral": false,
    "max_duration_secs": null,
    "idle_timeout_secs": null
  },
  "manifest_digest": null
}
--- state ---
claude/.credentials.json	absent:entity not found
codex/auth.json	absent:entity not found
codex/config.toml	absent:entity not found
copilot/config.json	[123, 34, 116, 114, 117, 115, 116, 101, 100, 95, 102, 111, 108, 100, 101, 114, 115, 34, 58, 91, 34, 47, 34, 93, 44, 34, 103, 105, 116, 104, 117, 98, 95, 116, 111, 107, 101, 110, 34, 58, 34, 109, 115, 98, 45, 99, 111, 112, 105, 108, 111, 116, 45, 112, 108, 97, 99, 101, 104, 111, 108, 100, 101, 114, 45, 118, 50, 34, 125]
link:.bash_history	/agent-vm-state/bash_history
link:.claude	/agent-vm-state/claude
link:.claude.json	/agent-vm-state/claude.json
link:.config/gh	/agent-vm-state/gh-config
link:.config/opencode	/agent-vm-state/opencode-config
link:.copilot	/agent-vm-state/copilot
link:.gitconfig	/agent-vm-state/gitconfig
link:.local/share/opencode	/agent-vm-state/opencode
opencode-config/opencode.json	absent:entity not found
secrets/anthropic	absent:entity not found
secrets/copilot	[102, 97, 107, 101]
secrets/openai	absent:entity not found