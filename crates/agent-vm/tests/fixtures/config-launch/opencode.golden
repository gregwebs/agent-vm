{
  "name": "agent-vm-normalized",
  "image": {
    "Oci": {
      "reference": "localhost:1/does-not-exist:latest",
      "root_disk": {
        "kind": "managed",
        "size_mib": 16384
      }
    }
  },
  "resources": {
    "cpus": 2,
    "memory_mib": 2048,
    "max_cpus": 2,
    "max_memory_mib": 2048
  },
  "runtime": {
    "workdir": "$PROJECT",
    "shell": "/bin/sh",
    "scripts": {},
    "entrypoint": null,
    "cmd": null,
    "hostname": null,
    "user": "$GUEST_UID:$GUEST_GID",
    "log_level": null,
    "metrics_sample_interval_ms": 1000,
    "disable_metrics_sample": false
  },
  "env": [
    {
      "key": "PATH",
      "value": "/usr/local/bin:/usr/bin:/usr/sbin:/bin"
    },
    {
      "key": "HOME",
      "value": "$HOME"
    },
    {
      "key": "USER",
      "value": "$GUEST_USER"
    },
    {
      "key": "LOGNAME",
      "value": "$GUEST_USER"
    },
    {
      "key": "IS_SANDBOX",
      "value": "1"
    },
    {
      "key": "LANG",
      "value": "C.UTF-8"
    }
  ],
  "labels": {},
  "rlimits": [],
  "mounts": [
    {
      "type": "Bind",
      "host": "$PROJECT",
      "guest": "$PROJECT",
      "options": {
        "readonly": false,
        "noexec": false,
        "nosuid": false,
        "nodev": false
      },
      "stat_virtualization": "strict",
      "host_permissions": "private",
      "follow_root_symlinks": false,
      "quota_mib": null
    },
    {
      "type": "Bind",
      "host": "$STATE_DIR",
      "guest": "/agent-vm-state",
      "options": {
        "readonly": false,
        "noexec": false,
        "nosuid": false,
        "nodev": false
      },
      "stat_virtualization": "strict",
      "host_permissions": "private",
      "follow_root_symlinks": false,
      "quota_mib": null
    },
    {
      "type": "Bind",
      "host": "$STATE_DIR/home",
      "guest": "$HOME",
      "options": {
        "readonly": false,
        "noexec": false,
        "nosuid": false,
        "nodev": false
      },
      "stat_virtualization": "strict",
      "host_permissions": "private",
      "follow_root_symlinks": false,
      "quota_mib": null
    }
  ],
  "patches": [
    {
      "Append": {
        "path": "/etc/passwd",
        "content": "$GUEST_USER:x:$GUEST_UID:$GUEST_GID::$HOME:/bin/bash\n"
      }
    }
  ],
  "network": {
    "enabled": true,
    "interface": {},
    "ports": [],
    "policy": {
      "default_egress": "deny",
      "default_ingress": "allow",
      "rules": [
        {
          "direction": "egress",
          "destination": {
            "group": "host"
          },
          "protocols": [
            "udp",
            "tcp"
          ],
          "ports": [
            {
              "start": 53,
              "end": 53
            }
          ],
          "action": "allow"
        },
        {
          "direction": "egress",
          "destination": {
            "group": "public"
          },
          "protocols": [],
          "ports": [],
          "action": "allow"
        }
      ]
    },
    "dns": {
      "rebind_protection": true,
      "nameservers": [],
      "query_timeout_ms": 5000
    },
    "tls": {
      "enabled": true,
      "intercepted_ports": [
        443
      ],
      "bypass": [],
      "verify_upstream": true,
      "block_quic_on_intercept": true,
      "upstream_ca_cert": [],
      "scoped_upstream_ca_cert": [],
      "scoped_verify_upstream": [],
      "intercept_ca": {
        "cert_path": null,
        "key_path": null
      },
      "cache": {
        "capacity": 1000,
        "validity_hours": 24
      }
    },
    "intercept": {
      "rules": [
        {
          "host": "auth.openai.com",
          "method": "POST",
          "path_prefix": "/oauth/token",
          "dispatch_on_headers": false
        }
      ],
      "hook": [
        "$AGENT_VM_BIN",
        "_intercept-hook",
        "--state-dir",
        "$STATE_DIR"
      ],
      "max_request_bytes": 2097152
    },
    "secrets": {
      "secrets": [
        {
          "env_var": "MSB_AGENT_VM_OPENAI_UNUSED",
          "value": "",
          "source": {
            "kind": "file",
            "path": "$STATE_DIR.secrets/openai"
          },
          "placeholder": "msb-openai-placeholder-a-v2",
          "allowed_hosts": [
            {
              "exact": "api.openai.com"
            },
            {
              "exact": "chatgpt.com"
            },
            {
              "exact": "auth.openai.com"
            }
          ],
          "injection": {
            "headers": true,
            "basic_auth": false,
            "query_params": false,
            "body": false
          },
          "require_tls_identity": true
        },
        {
          "env_var": "MSB_AGENT_VM_OPENCODE_OPENAI_UNUSED",
          "value": "",
          "source": {
            "kind": "file",
            "path": "$STATE_DIR.secrets/openai"
          },
          "placeholder": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJleHAiOjk5OTk5OTk5OTksImNoYXRncHRfYWNjb3VudF9pZCI6IjAwMDAwMDAwLTAwMDAtMDAwMC0wMDAwLTAwMDAwMDAwMDAwMCJ9.msb-opencode-placeholder-av2",
          "allowed_hosts": [
            {
              "exact": "api.openai.com"
            },
            {
              "exact": "chatgpt.com"
            }
          ],
          "injection": {
            "headers": true,
            "basic_auth": false,
            "query_params": false,
            "body": false
          },
          "require_tls_identity": true
        }
      ],
      "on_violation": "block-and-log"
    },
    "max_connections": null,
    "trust_host_cas": false
  },
  "init": null,
  "pull_policy": "IfMissing",
  "security_profile": "default",
  "deployment_profile": "single_tenant",
  "lifecycle": {
    "ephemeral": false,
    "max_duration_secs": null,
    "idle_timeout_secs": null
  },
  "manifest_digest": null
}
--- state ---
claude/.credentials.json	absent:entity not found
codex/auth.json	[123, 34, 116, 111, 107, 101, 110, 115, 34, 58, 123, 34, 97, 99, 99, 101, 115, 115, 95, 116, 111, 107, 101, 110, 34, 58, 34, 109, 115, 98, 45, 111, 112, 101, 110, 97, 105, 45, 112, 108, 97, 99, 101, 104, 111, 108, 100, 101, 114, 45, 97, 45, 118, 50, 34, 44, 34, 114, 101, 102, 114, 101, 115, 104, 95, 116, 111, 107, 101, 110, 34, 58, 34, 109, 115, 98, 45, 111, 112, 101, 110, 97, 105, 45, 112, 108, 97, 99, 101, 104, 111, 108, 100, 101, 114, 45, 114, 45, 118, 50, 34, 44, 34, 97, 99, 99, 111, 117, 110, 116, 95, 105, 100, 34, 58, 34, 48, 48, 48, 48, 48, 48, 48, 48, 45, 48, 48, 48, 48, 45, 48, 48, 48, 48, 45, 48, 48, 48, 48, 45, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 34, 125, 125]
